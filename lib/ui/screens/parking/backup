import 'dart:async';
import 'dart:io';
import 'dart:typed_data';
import 'package:flutter/material.dart';
import 'package:get/get.dart';

import 'package:parkit_smart_parking_assistant/ui/widgets/add_motor_warning.dart';
import 'package:parkit_smart_parking_assistant/ui/widgets/parking_slot_map.dart';
import 'package:parkit_smart_parking_assistant/ui/widgets/live_feed_widget.dart';
import 'package:parkit_smart_parking_assistant/ui/widgets/recommendation_carousel.dart';
import 'package:parkit_smart_parking_assistant/services/parking_service.dart';
import 'package:parkit_smart_parking_assistant/models/recommended_slot.dart';

class ParkingScreen extends StatefulWidget {
  const ParkingScreen({super.key});

  @override
  State<ParkingScreen> createState() => _ParkingScreenState();
}

class _ParkingScreenState extends State<ParkingScreen> {
  static const Duration refreshInterval = Duration(seconds: 5);
  Timer? _timer;

  bool _loading = true; // prevent overlapping requests UI-wise
  bool _isFetching = false; // prevent overlapping requests network-wise

  int total = 0;
  int occupied = 0;
  int free = 0;

  String? annotatedImageUrl;
  Uint8List? annotatedImageBytes; // NEW: hold binary image if API returns bytes
  List<RecommendedSlot> recommended = [];

  @override
  void initState() {
    super.initState();
    _startPolling();
  }

  void _startPolling() {
    // call immediately, then schedule periodic calls
    _safeFetchLive();
    _timer = Timer.periodic(refreshInterval, (_) => _safeFetchLive());
  }

  @override
  void dispose() {
    // stop timer to avoid callbacks after dispose
    _timer?.cancel();
    _timer = null;
    super.dispose();
  }

  /// Safe wrapper that avoids overlapping calls and checks mounted before setState.
  Future<void> _safeFetchLive() async {
    if (_isFetching) return; // skip if previous request still running
    _isFetching = true;
    try {
      await _fetchLive();
    } finally {
      _isFetching = false;
    }
  }

  /// Actual fetch function with robust error handling.
  Future<void> _fetchLive() async {
    // If widget is already unmounted, bail out
    if (!mounted) return;

    try {
      if (!mounted) return;
      setState(() => _loading = true);

      final data = await ParkingService.fetchLive();

      if (!mounted) return;

      // handle no live session / endpoint not found
      if (data["status"] == "no_live") {
        Get.snackbar(
          "No Live Session",
          data["detail"]?.toString() ?? "Tidak ada sesi deteksi aktif.",
          snackPosition: SnackPosition.BOTTOM,
          backgroundColor: Colors.orange.shade100,
        );
        if (!mounted) return;
        setState(() {
          total = 0;
          occupied = 0;
          free = 0;
          annotatedImageUrl = null;
          annotatedImageBytes = null;
          recommended = [];
          _loading = false;
        });
        return;
      }

      if (data["status"] == "error") {
        Get.snackbar(
          "Server Error",
          "Code ${data["code"]} — ${data["body"]}",
          snackPosition: SnackPosition.BOTTOM,
          backgroundColor: Colors.orange.shade100,
        );
        if (!mounted) return;
        setState(() => _loading = false);
        return;
      }

      // parse normal successful payload
      final tot =
          data["max_detection_count"] ??
          data["total"] ??
          data["total_slots"] ??
          data["count"] ??
          0;

      final bestFrame = (data["best_frame"] is Map)
          ? Map<String, dynamic>.from(data["best_frame"])
          : null;

      final occ =
          bestFrame?["total_motorcycles"] ??
          data["occupied"] ??
          data["terisi"] ??
          data["used"] ??
          0;

      final fr =
          bestFrame?["total_empty_spaces"] ??
          data["free"] ??
          data["kosong"] ??
          ((tot is int)
              ? (tot - (occ is int ? occ : int.tryParse(occ.toString()) ?? 0))
              : 0);

      final imgTop =
          data["annotated_image"] ??
          data["annotated_image_url"] ??
          data["image"];
      final imgBF = bestFrame?["annotated_image"] ?? bestFrame?["image"];
      final img = imgTop ?? imgBF;

      // NEW: check if API returned raw bytes (List<int>)
      final dynamic maybeBytes = data["imageBytes"] ?? data["image_bytes"];
      Uint8List? bytes;
      if (maybeBytes != null) {
        try {
          if (maybeBytes is List<int>) {
            bytes = Uint8List.fromList(maybeBytes);
          } else if (maybeBytes is Uint8List) {
            bytes = maybeBytes;
          }
        } catch (_) {
          bytes = null;
        }
      }

      dynamic rawRec = data["recommended"] ?? data["recommendations"];
      if (rawRec == null && bestFrame != null)
        rawRec = bestFrame["empty_spaces"];
      rawRec ??= [];

      final List<RecommendedSlot> recs = (rawRec is List)
          ? rawRec.where((e) => e != null).map<RecommendedSlot>((e) {
              if (e is Map) {
                return RecommendedSlot.fromMap(Map<String, dynamic>.from(e));
              } else {
                final s = e?.toString() ?? "Slot";
                return RecommendedSlot(
                  slot: s,
                  distance: '-',
                  eta: '-',
                  sessionId: '',
                );
              }
            }).toList()
          : <RecommendedSlot>[];

      if (!mounted) return;

      setState(() {
        total = (tot is int) ? tot : int.tryParse(tot.toString()) ?? 0;
        occupied = (occ is int) ? occ : int.tryParse(occ.toString()) ?? 0;
        free = (fr is int)
            ? fr
            : int.tryParse(fr.toString()) ?? (total - occupied);

        // If bytes available → use bytes (higher priority). Else use URL if present.
        if (bytes != null && bytes.isNotEmpty) {
          annotatedImageBytes = bytes;
          annotatedImageUrl = null;
        } else {
          annotatedImageBytes = null;
          annotatedImageUrl = (img == null)
              ? null
              : (img is String ? ParkingService.absoluteImageUrl(img) : null);
        }

        recommended = recs;
        _loading = false;
      });
    } on TimeoutException catch (_) {
      if (!mounted) return;
      debugPrint("ParkingScreen._fetchLive error: Timeout");
      Get.snackbar(
        "Gagal memuat",
        "Request timeout. Periksa koneksi atau server.",
        snackPosition: SnackPosition.BOTTOM,
        backgroundColor: Colors.orange.shade100,
      );
      if (!mounted) return;
      setState(() => _loading = false);
    } on SocketException catch (_) {
      if (!mounted) return;
      debugPrint(
        "ParkingScreen._fetchLive error: Connection failed (SocketException)",
      );
      Get.snackbar(
        "Koneksi gagal",
        "Tidak dapat terhubung ke server. Periksa jaringan atau URL backend.",
        snackPosition: SnackPosition.BOTTOM,
        backgroundColor: Colors.orange.shade100,
      );
      if (!mounted) return;
      setState(() => _loading = false);
    } catch (e, st) {
      debugPrint("ParkingScreen._fetchLive error: $e\n$st");
      if (!mounted) return;
      Get.snackbar(
        "Gagal memuat live data",
        e.toString(),
        snackPosition: SnackPosition.BOTTOM,
        backgroundColor: Colors.orange.shade100,
      );
      if (!mounted) return;
      setState(() => _loading = false);
    }
  }

  void _onRecommendationTap(RecommendedSlot s) {
    Get.snackbar(
      "Navigasi",
      "Mulai navigasi ke ${s.slot}",
      snackPosition: SnackPosition.BOTTOM,
      backgroundColor: Colors.green.shade100,
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFF4F7FE),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const SizedBox(height: 10),
            AddMotorWarning(),
            const SizedBox(height: 16),
            const Text(
              "Status Slot",
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.w700),
            ),
            const SizedBox(height: 20),
            Row(
              children: [
                Expanded(
                  child: _stat(
                    icon: Icons.grid_view_rounded,
                    color: Colors.blue,
                    label: "Total",
                    value: total.toString(),
                    bg: const Color(0xFFEAF1FF),
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: _stat(
                    icon: Icons.motorcycle_rounded,
                    color: Colors.red,
                    label: "Terisi",
                    value: occupied.toString(),
                    bg: const Color(0xFFFFEAEA),
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: _stat(
                    icon: Icons.check_circle_rounded,
                    color: Colors.green,
                    label: "Kosong",
                    value: free.toString(),
                    bg: const Color(0xFFE9FFF0),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 20),
            const ParkingSlotMap(),
            const SizedBox(height: 24),
            const Text(
              "Deteksi Real-Time",
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.w700),
            ),
            const SizedBox(height: 14),
            LiveFeedWidget(
              loading: _loading,
              annotatedImageUrl: annotatedImageUrl,
              annotatedImageBytes: annotatedImageBytes, // pass bytes if any
              onTap: () {
                if (annotatedImageBytes != null ||
                    (annotatedImageUrl != null &&
                        annotatedImageUrl!.isNotEmpty)) {
                  Get.snackbar(
                    "Info",
                    "Buka Live Feed (belum diimplementasikan)",
                    snackPosition: SnackPosition.BOTTOM,
                    backgroundColor: Colors.blue.shade50,
                  );
                } else {
                  Get.snackbar(
                    "Info",
                    "Tidak ada feed saat ini",
                    snackPosition: SnackPosition.BOTTOM,
                    backgroundColor: Colors.orange.shade100,
                  );
                }
              },
            ),
            const SizedBox(height: 20),
            const Text(
              "Rekomendasi Slot",
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.w700),
            ),
            const SizedBox(height: 12),
            RecommendationCarousel(
              items: recommended,
              onTap: _onRecommendationTap,
            ),
            const SizedBox(height: 24),
          ],
        ),
      ),
    );
  }

  Widget _stat({
    required IconData icon,
    required Color color,
    required String value,
    required String label,
    required Color bg,
  }) {
    return Container(
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(12),
        boxShadow: [
          BoxShadow(
            color: Colors.black12.withOpacity(0.05),
            blurRadius: 8,
            offset: const Offset(0, 3),
          ),
        ],
      ),
      child: Column(
        children: [
          Container(
            padding: const EdgeInsets.all(8),
            decoration: BoxDecoration(
              color: bg,
              borderRadius: BorderRadius.circular(12),
            ),
            child: Icon(icon, color: color, size: 28),
          ),
          const SizedBox(height: 8),
          Text(
            value,
            style: const TextStyle(fontWeight: FontWeight.w800, fontSize: 15),
          ),
          Text(label, style: const TextStyle(color: Colors.black54)),
        ],
      ),
    );
  }
}
